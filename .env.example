# Copy this file to .env and fill it in. Never commit or share .env (it holds secrets).

# --- Basics ---------------------------------------------------------------
NODE_ENV=development          # set to production on the live server
PORT=3000
SITE_URL=http://localhost:3000   # live: https://meltmare.com (used for Cashfree return and webhook URLs)
DATA_DIR=./data               # orders, customers and uploaded photos live here: back it up

# Long random text, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED when NODE_ENV=production
SESSION_SECRET=

# Behind Nginx/Render/Railway/Cloudflare? set to 1 so rate limits see the real visitor IP
TRUST_PROXY=0

# --- Admin panel (/admin) -------------------------------------------------
ADMIN_EMAIL=admin@meltmare.com
# Create with:  npm run hash-password -- "your long admin password"   then paste the whole line here
ADMIN_PASSWORD_HASH=

# --- Cashfree payments ----------------------------------------------------
# Leave both empty in development to use the built in test payment page.
# Sandbox keys: Cashfree dashboard > Developers > API Keys (Test). Live keys only after KYC approval.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox          # sandbox or production
# In the Cashfree dashboard add this webhook URL:  <SITE_URL>/api/cashfree/webhook  (events: Payment Success, Payment Failed)

# --- Sign in codes (OTP) --------------------------------------------------
# Email codes and order emails: create a free account at resend.com, verify meltmare.com, paste the key.
RESEND_API_KEY=
MAIL_FROM=MELTMARE <orders@meltmare.com>
# Phone codes in India need a DLT registered sender and template. MSG91 is supported:
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Optional: get an email for every paid order
ADMIN_NOTIFY_EMAIL=

# --- Store details shown on the site -------------------------------------
STORE_EMAIL=hello@meltmare.com
STORE_PHONE=
STORE_ADDRESS=
STORE_HOURS=Mon–Sat, 10 am – 6 pm
# Set to 1 once the client has reviewed the four policy pages (removes the "Draft policy" label)
POLICIES_REVIEWED=0

# --- Shop rules -----------------------------------------------------------
FREE_SHIPPING_ABOVE=999
SHIPPING_FEE=79
PENDING_ORDER_MINUTES=30      # unpaid orders are cancelled and stock released after this

# --- Development only (ignored when NODE_ENV=production) -----------------
# 1 = show the sign in code on the login screen so you can test without email/SMS
DEV_SHOW_OTP=1
# Fixed admin password for local testing when ADMIN_PASSWORD_HASH is empty (otherwise a random one is printed at start)
DEV_ADMIN_PASSWORD=
